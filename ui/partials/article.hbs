<article>
{{#unless page.home}}
<header class="post-header">
<h1>{{{page.title}}}</h1>
{{#if page.attributes.date}}
<p class="meta"><time datetime="{{page.attributes.date}}">{{page.attributes.date}}</time>
{{#each (split page.attributes.categories)}}
<a href="{{../siteRootPath}}/category/{{slug this}}/">{{this}}</a>
{{/each}}
</p>
{{/if}}
</header>
{{/unless}}
<div class="content">
{{{page.contents}}}
</div>
{{#if page.attributes.tags}}
<footer class="post-tags">
<ul>
{{#each (split page.attributes.tags)}}
<li><a href="{{../siteRootPath}}/tag/{{slug this}}/">{{this}}</a></li>
{{/each}}
</ul>
</footer>
{{/if}}
</article>
